# Era Dijital Panel - Environment Configuration
# Copy this file as .env and fill in your database credentials

DB_HOST=localhost
DB_NAME=eradijital_panel
DB_USER=root
DB_PASS=
APP_ENV=development
APP_DEBUG=true

# Frontend domain (for CORS)
FRONTEND_URL=https://eradijital.com

# API Secret Key for remote publishing (e.g. from sosyalmedya-ajans)
API_SECRET_KEY=era_secret_key_2026

# Google Gemini API Key for in-panel AI Blog generation
GEMINI_API_KEY=
